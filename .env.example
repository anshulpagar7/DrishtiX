# Copy to .env and fill in. NEVER commit .env - it is gitignored.
# On Kaggle use Add-ons -> Secrets instead of a file.

# ---------------------------------------------------------------------------
# LLM parser backend.  offline | openai_compat | gemini
# Leaving this unset is fine - the app falls back to the rule parser.
# ---------------------------------------------------------------------------
SATQUERY_LLM_BACKEND=offline

# Groq free tier (OpenAI-compatible)
SATQUERY_LLM_BASE=https://api.groq.com/openai/v1
SATQUERY_LLM_MODEL=llama-3.1-8b-instant
SATQUERY_LLM_KEY=

# Google AI Studio free tier
SATQUERY_GEMINI_MODEL=gemini-2.0-flash
SATQUERY_GEMINI_KEY=

# ---------------------------------------------------------------------------
# Vision-language model
# Verify a 4-bit load fits a Kaggle T4 BEFORE planning around a checkpoint.
# ---------------------------------------------------------------------------
SATQUERY_VLM=Qwen/Qwen2-VL-2B-Instruct
SATQUERY_VLM_ADAPTER=
SATQUERY_VLM_4BIT=1

# ---------------------------------------------------------------------------
# Dataset subset sizes. Small on purpose - full BigEarthNet is >100 GB.
# ---------------------------------------------------------------------------
SATQUERY_N_BEN=4000
SATQUERY_N_RSVQA=3000
